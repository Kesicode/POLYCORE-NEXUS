# PolyCore Nexus — Root Environment Configuration
# Copy this to .env and fill in your values
# NEVER commit the actual .env file

# ============================================================
# DATABASE
# ============================================================
DATABASE_URL=postgresql://polycore:polycore_secret@localhost:5432/polycore_nexus
POSTGRES_DB=polycore_nexus
POSTGRES_USER=polycore
POSTGRES_PASSWORD=polycore_secret

# ============================================================
# REDIS
# ============================================================
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=

# ============================================================
# JWT
# ============================================================
# Generate with: openssl rand -hex 64
JWT_SECRET=change_me_to_a_long_random_secret_minimum_64_characters_long_please
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# ============================================================
# AI PROVIDERS (all optional — graceful fallback if missing)
# ============================================================
# Google Gemini (recommended — free tier available)
GEMINI_API_KEY=

# OpenAI (fallback)
OPENAI_API_KEY=

# Anthropic (fallback)
ANTHROPIC_API_KEY=

# ============================================================
# MQTT / IoT
# ============================================================
MQTT_BROKER_URL=mqtt://localhost:1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_CLIENT_ID=polycore-server

# ============================================================
# SERVICE PORTS
# ============================================================
WEB_PORT=3000
API_GATEWAY_PORT=8080
AI_SERVICE_PORT=8001
EXECUTION_SERVICE_PORT=8002
JAVA_SERVICE_PORT=8003
REALTIME_SERVICE_PORT=8004
IOT_SERVICE_PORT=8005

# ============================================================
# EXECUTION SECURITY LIMITS
# ============================================================
EXECUTION_DEFAULT_TIMEOUT_SECS=10
EXECUTION_MAX_TIMEOUT_SECS=30
EXECUTION_MAX_MEMORY_MB=128
EXECUTION_MAX_PROCESSES=32
EXECUTION_MAX_OUTPUT_KB=1024

# ============================================================
# DOCKER
# ============================================================
DOCKER_HOST=unix:///var/run/docker.sock
# On Windows with Docker Desktop:
# DOCKER_HOST=npipe:////./pipe/docker_engine

# ============================================================
# MONITORING
# ============================================================
PROMETHEUS_PORT=9090
GRAFANA_PORT=3001
GRAFANA_ADMIN_PASSWORD=admin

# ============================================================
# APPLICATION
# ============================================================
ENVIRONMENT=development
LOG_LEVEL=info
CORS_ORIGINS=http://localhost:3000
