#pragma once

// PolyCore Nexus — ESP32 Firmware Configuration
// Copy this file to config.h and fill in your values

// WiFi settings
#define WIFI_SSID       "YourNetworkName"
#define WIFI_PASSWORD   "YourNetworkPassword"

// MQTT Broker
#define MQTT_BROKER_HOST  "192.168.1.100"  // IP of PolyCore Nexus server
#define MQTT_BROKER_PORT  1883
#define MQTT_CLIENT_ID    "polycore-esp32-001"
#define DEVICE_ID         "esp32-001"

// MQTT Topics (auto-constructed from DEVICE_ID)
#define MQTT_TOPIC_TELEMETRY  "polycore/devices/" DEVICE_ID "/telemetry"
#define MQTT_TOPIC_COMMANDS   "polycore/devices/" DEVICE_ID "/commands"
#define MQTT_TOPIC_STATUS     "polycore/devices/" DEVICE_ID "/status"

// Sensor configuration
#define TELEMETRY_INTERVAL_MS   3000   // Publish telemetry every 3 seconds
#define SENSOR_DHT_PIN          4      // DHT22 temperature/humidity sensor pin
#define SENSOR_ENABLE_DHT       true

// Hardware LEDs
#define LED_STATUS_PIN    2    // Built-in LED (status)
#define LED_WIFI_PIN      -1   // External WiFi LED (-1 = disabled)

// Firmware info
#define FIRMWARE_VERSION  "1.0.0"
#define HARDWARE_MODEL    "ESP32-WROOM-32"
